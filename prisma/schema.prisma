// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The legacy `User` model has been removed. Role-specific models
// (`Student`, `Teacher`, `Admin`) are used instead.

model Exam {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Creator (Teacher)
  createdById String
  createdBy   Teacher   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  enrollments EnrolledExam[]
  questions   Question[]
  
  @@index([createdById])
}

model EnrolledExam {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  score     Float?
  status    String    @default("pending") // "pending", "completed", "graded"
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  @@unique([studentId, examId])
  @@index([examId])
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Creator (Teacher)
  createdById String
  createdBy   Teacher   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  submissions Submission[]

  @@index([createdById])
}

model Submission {
  id            String    @id @default(cuid())
  content       String?
  fileUrl       String?
  score         Float?
  feedback      String?
  status        String    @default("submitted") // "submitted", "graded", "returned"
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?

  // Relations
  studentId     String
  student       Student   @relation("SubmittedBy", fields: [studentId], references: [id], onDelete: Cascade)
  
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  gradedById    String?
  gradedBy      Teacher?  @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([studentId, assignmentId])
  @@index([assignmentId])
  @@index([gradedById])
}

model Question {
  id        String    @id @default(cuid())
  type      String    // "multiple_choice", "short_answer", "essay"
  content   String
  options   String?   // JSON array for multiple choice
  answer    String?   // Correct answer(s)
  order     Int
  
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

// Separate role-specific models for clearer separation of concerns.
// These are kept simple and do not replace the existing `User` model
// to preserve backward compatibility. You can migrate logic to use
// these models later as needed.
model Student {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments EnrolledExam[]
  submissions Submission[] @relation("SubmittedBy")

  @@index([email])
}

model Teacher {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdExams      Exam[]
  createdAssignments Assignment[]
  gradedSubmissions Submission[] @relation("GradedBy")

  @@index([email])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  subject     String
  type        String
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}